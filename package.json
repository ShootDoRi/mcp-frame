{
  "name": "mcp-frame",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript-first React toolkit for safe, typed, testable MCP app frames.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm build:packages && pnpm --filter todo-frame build",
    "build:packages": "pnpm -r --filter './packages/**' build",
    "release:pack": "node scripts/release-pack.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "release:check": "pnpm typecheck && pnpm test && pnpm build && pnpm --filter ./examples/todo-frame build && pnpm release:smoke",
    "test": "pnpm build:packages && pnpm -r --filter './packages/**' test:run",
    "typecheck": "pnpm build:packages && pnpm -r --filter './packages/**' typecheck && pnpm --filter todo-frame typecheck"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.1",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "zod": "^3.25.56"
  }
}
